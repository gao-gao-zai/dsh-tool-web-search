{
  "name": "dsh-tool-web-search",
  "description": "Persistent DSH model tools for Bing and SearXNG web search plus bounded webpage fetching.",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.mjs"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.mjs",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.mjs.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gao-gao-zai/dsh-tool-web-search.git"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "turndown": "^7.2.4",
    "@joplin/turndown-plugin-gfm": "^1.0.67"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/turndown": "^5.0.6",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && pnpm run build:client",
    "build:client": "tsdown src/client.ts --no-config --format cjs --out-dir lib/.client-build --sourcemap --platform browser --deps.never-bundle react --deps.never-bundle @deepseek-ai/dsh-client-runtime --deps.never-bundle @deepseek-ai/dsh-client-ui-settings --deps.never-bundle @deepseek-ai/dsh-client-ui-slots && node scripts/wrap-client.mjs",
    "bundle": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
